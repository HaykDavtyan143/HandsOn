<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@color/handson"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Post"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:textColor="@color/background_light"
            android:layout_centerInParent="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </RelativeLayout>


    <EditText
        android:id="@+id/edit_text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter post title"
        android:inputType="text"
        android:textSize="18sp"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edittext"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"/>

    <EditText
        android:id="@+id/edit_text_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter post description"
        android:inputType="textMultiLine"
        android:textSize="18sp"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edittext"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/edit_text_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"/>

    <TextView
        android:id="@+id/text_view_expiration_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Select expiration date"
        android:padding="12dp"
        android:textSize="18sp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_edittext"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/ic_calendar"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:inputType="none"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/edit_text_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"/>

    <TextView
        android:id="@+id/tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select category"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/text_view_expiration_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="35dp"
        android:padding="8dp"
        app:columnCount="2">

        <RadioButton
            android:id="@+id/category_environment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Environment"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_education"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Education"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_health"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Health"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_animal_welfare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Animal Welfare"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_community"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Community"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_arts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Arts and Culture"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_sports"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Sports"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_technology"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Technology"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_human_rights"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Human Rights"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_disaster"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Disaster Relief"
            app:buttonTint="@color/handson" />

        <RadioButton
            android:id="@+id/category_recommendation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_columnWeight="1"
            android:text="Suggestion"
            app:buttonTint="@color/handson" />

    </androidx.gridlayout.widget.GridLayout>

    <Button
        android:id="@+id/button_add_post"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add Post"
        android:background="@drawable/bg_button"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/select"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        app:backgroundTint="@color/handson"
        android:layout_marginTop="16dp" />


    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <fragment
        android:id="@+id/navigationBarFragment"
        android:name="com.haykdavtyan.handson.NavigationBarFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
